<h1>Journal entry</h1>
<% if current_user.provider? %>
  <p><%= link_to @journal_entry.client.name, client_journal_entries_path(@journal_entry.client) %> · Read-only</p>
<% end %>
<p>Created <%= @journal_entry.created_at.to_fs(:long) %></p>
<%= simple_format(@journal_entry.text) %>
<%= link_to "Edit entry", edit_journal_entry_path(@journal_entry) if policy(@journal_entry).update? %>
<%= button_to "Delete entry", @journal_entry, method: :delete if policy(@journal_entry).destroy? %>
<p><%= link_to current_user.provider? ? "Combined journal feed" : "My journal", journal_entries_path %></p>
