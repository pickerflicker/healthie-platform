<% if providers.empty? %>
  <p>No current relationships.</p>
<% else %>
  <table>
    <thead><tr><th>Provider</th><th>Plan</th><th>Action</th></tr></thead>
    <tbody>
      <% providers.each do |provider| %>
        <tr>
          <td><%= provider_name(provider[:name], provider[:credentials]) %></td>
          <td><%= provider[:plan].humanize %></td>
          <% if policy(enrollment).destroy? %>
            <td><%= button_to "Remove #{provider[:name]}", enrollment_path(provider[:enrollment_id]), method: :delete %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
