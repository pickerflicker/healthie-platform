<div class="page-heading"><div><h1><%= current_user.client? ? "My providers" : "My clients" %></h1><p><%= current_user.client? ? "Choose who can read your journal and manage your current relationships." : "Open a journal to catch up on a client’s reflections." %></p></div></div>
<% if current_user.client? %>
  <%= render "provider_list", providers: @provider_list, enrollment: @enrollment %>
<% elsif @enrollments.empty? %>
  <section class="empty-state"><span class="home-icon" aria-hidden="true">♡</span><h2>No current clients</h2><p>No current relationships.</p><p>Clients appear here when they add you as a provider.</p></section>
<% else %>
  <table class="provider-list" aria-label="Current clients">
    <colgroup><col><col class="plan-column"></colgroup>
    <thead class="sr-only"><tr><th>Client</th><th>Plan</th></tr></thead>
    <tbody>
      <% @enrollments.each do |enrollment| %>
        <tr class="client-row">
          <td><%= link_to enrollment.client.name, client_journal_entries_path(enrollment.client), class: "link link-hover" %></td>
          <td class="plan-cell"><span class="badge <%= enrollment.premium? ? "badge-accent" : "badge-secondary" %>"><%= enrollment.plan.humanize %></span></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
<% if current_user.provider? %><p class="sharing-note">Clients manage their provider relationships and plans. Your journal access is read-only.</p><p class="mt-6"><%= link_to "Combined journal feed", journal_entries_path, class: "link link-primary" %></p><% end %>
<% if @enrollment && policy(@enrollment).create? %>
  <section class="form-panel add-provider">
    <h2>Add a provider</h2>
    <p class="field-hint">Adding a provider grants them access to your existing and future journal entries. Removing a provider revokes that access and keeps your journal entries.</p>
    <% if @enrollment.errors.any? %><div class="alert alert-error mt-5" role="alert" id="enrollment-errors"><span><%= @enrollment.errors.full_messages.to_sentence %></span></div><% end %>
    <% if @available_providers.empty? %>
      <p class="soft-note mt-5">All available providers are already added.</p>
    <% else %>
      <%= form_with model: @enrollment, url: enrollments_path, data: { controller: "pending", action: "turbo:submit-start->pending#start turbo:submit-end->pending#finish" } do |form| %>
        <div class="form-grid">
          <div><%= form.label :provider_id, "Provider", class: "field-label" %><%= form.select :provider_id, @available_providers.map { |provider| [provider_name(provider.name, provider.credentials), provider.id] }, {}, class: "select w-full", aria: { describedby: ("enrollment-errors" if @enrollment.errors.any?) } %></div>
          <div><%= form.label :plan, "Plan", class: "field-label" %><%= form.select :plan, [["Basic", "basic"], ["Premium", "premium"]], {}, class: "select w-full", aria: { describedby: ("enrollment-errors" if @enrollment.errors.any?) } %></div>
        </div>
        <div class="form-actions"><%= form.submit "Add provider", class: "btn btn-primary", data: { turbo_submits_with: "Adding…" } %></div>
        <p class="pending" role="status" data-pending-target="message" hidden>Adding your provider…</p>
      <% end %>
    <% end %>
  </section>
<% end %>
